  "fixed_sql": [
    {
      "name": "orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"orders\" (\"id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"total_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'THB', \"line_count\" INTEGER NOT NULL DEFAULT 0, \"item_count\" INTEGER NOT NULL DEFAULT 0, \"primary_sku\" TEXT NULL, \"primary_name\" TEXT NULL, \"primary_image_url\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"order_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"idempotency_key\" TEXT NOT NULL UNIQUE, \"if_match_version\" INTEGER NULL, \"state\" TEXT NOT NULL DEFAULT 'pending', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"user_id\" TEXT NULL, \"sync_seq\" INTEGER NULL, \"older_cursor\" TEXT NULL, \"reached_end\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reached_end\" IN (0, 1)), \"last_synced_at\" INTEGER NULL, \"oldest_created_at\" INTEGER NULL, \"oldest_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "orders_created_idx",
